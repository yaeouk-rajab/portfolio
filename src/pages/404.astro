---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
---

<Base title="Not found" noindex>
  <Section id="not-found" as="h1" path="~" command="cd: no such file or directory">
    <p class="text-muted">That page does not exist. <a class="link" href="/">Back to the home page</a>.</p>
  </Section>
</Base>
