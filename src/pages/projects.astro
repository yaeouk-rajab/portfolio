---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import { projects } from '../lib/content';

const categories = ['web', 'mobile', 'backend', 'library'] as const;
const options = categories
  .map((c) => ({ value: c, count: projects.filter((p) => p.category === c).length }))
  .filter((o) => o.count > 0)
  .map((o) => ({ ...o, anchor: `cat-${o.value}` }));
---

<Base title="Projects" description={`All ${projects.length} projects by Ahmed Rajab, filterable by web, mobile, backend and library, each with its verification status.`}>
  <Section id="projects" as="h1" path="~/projects" command="ls">
    <p class="mb-6 max-w-2xl text-muted">
      {projects.length} projects. Each page has the architecture, the stack and what has not been verified.
    </p>
    <CategoryFilter label="Filter projects by category" target="project-list" options={options} total={projects.length}>
      <ul id="project-list" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((project) => (
            <li data-filter={project.category}>
              <ProjectCard project={project} headingLevel="h2" />
            </li>
          ))
        }
      </ul>
    </CategoryFilter>
  </Section>
</Base>
