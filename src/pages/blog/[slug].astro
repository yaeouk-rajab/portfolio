---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TagChip from '../../components/TagChip.astro';
import { getPublishedPosts, formatDate } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags } = post.data;
---

<Base title={title} description={description} type="article" publishedTime={date}>
  <article class="mx-auto w-full max-w-5xl px-4 py-12 sm:py-16">
    <nav aria-label="Breadcrumb" class="font-mono text-sm text-muted">
      <a class="link" href="/blog">blog</a> / <span aria-current="page">{post.id}</span>
    </nav>
    <header class="mt-6 max-w-[68ch]">
      <p class="font-mono text-sm text-muted">
        <time datetime={formatDate(date)}>{formatDate(date)}</time>
      </p>
      <h1 class="prompt mt-3 text-3xl leading-tight sm:text-4xl">{title}</h1>
      <p class="mt-4 text-lg text-muted">{description}</p>
      {tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Tags">
          {tags.map((tag) => <li><TagChip label={tag} /></li>)}
        </ul>
      )}
    </header>
    <div class="prose-site mt-10">
      <Content />
    </div>
    <p class="mt-12 font-mono text-sm">
      <a class="link" href="/blog">&larr; all posts</a>
    </p>
  </article>
</Base>
