---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import TagChip from '../../components/TagChip.astro';
import { getPublishedPosts, formatDate } from '../../lib/blog';

const posts = await getPublishedPosts();
---

<Base title="Blog" description="Notes on backend, mobile and template work by Ahmed Rajab.">
  <Section id="blog" as="h1" path="~/blog" command="ls -t">
    {
      posts.length === 0 ? (
        <p class="text-muted">No posts yet.</p>
      ) : (
        <ul class="grid gap-4">
          {posts.map((post) => (
            <li>
              <article class="relative rounded-lg border border-line bg-surface p-5 transition-colors hover:border-accent focus-within:border-accent">
                <p class="font-mono text-xs text-muted">
                  <time datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
                </p>
                <h2 class="mt-2 font-mono text-lg font-semibold">
                  <a href={`/blog/${post.id}`} class="text-text no-underline after:absolute after:inset-0 after:content-[''] hover:text-accent focus-visible:outline-offset-4">
                    {post.data.title}
                  </a>
                </h2>
                <p class="mt-2 text-sm text-muted">{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Tags">
                    {post.data.tags.map((tag) => <li><TagChip label={tag} /></li>)}
                  </ul>
                )}
              </article>
            </li>
          ))}
        </ul>
      )
    }
    <p class="mt-8 font-mono text-sm">
      <a class="link" href="/rss.xml">RSS feed</a>
    </p>
  </Section>
</Base>
