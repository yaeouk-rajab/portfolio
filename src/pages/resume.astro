---
import Base from '../layouts/Base.astro';
import { projects, templates, techForCategory } from '../lib/content';
import { site } from '../data/site';

const github = site.social.find((s) => s.label === 'GitHub');
const categories = [
  { key: 'web', label: 'Web' },
  { key: 'mobile', label: 'Mobile' },
  { key: 'backend', label: 'Backend' },
  { key: 'library', label: 'Libraries' },
] as const;
---

<Base title="Resume" description="Resume of Ahmed Rajab: skills and projects built from the portfolio data.">
  <article class="resume mx-auto w-full max-w-3xl px-4 py-12 sm:py-16">
    <div class="no-print flex flex-col items-start gap-3">
      <a href="/resume.pdf" class="btn btn-ghost" download>Download PDF</a>
    </div>

    <header class="mt-8 border-b border-line pb-6">
      <h1 class="prompt text-3xl sm:text-4xl">{site.name}</h1>
      <p class="mt-1 font-mono text-accent">{site.role}</p>
      <p class="mt-4">{site.tagline}</p>
      <p class="mt-3 font-mono text-sm">
        <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
        {' · '}
        <a class="link" href={`mailto:${site.emailSecondary}`}>{site.emailSecondary}</a>
        {' · '}
        <a class="link" href={site.phoneHref}>{site.phone}</a>
        {github?.enabled && (
          <>
            {' · '}
            <a class="link" href={github.url} rel="me noopener">github.com/{site.githubUser}</a>
          </>
        )}
      </p>
    </header>

    <section aria-labelledby="summary-heading" class="mt-8">
      <h2 id="summary-heading" class="prompt text-xl">Summary</h2>
      <p class="mt-4 text-sm">{site.summary}</p>
    </section>

    <section aria-labelledby="experience-heading" class="mt-8">
      <h2 id="experience-heading" class="prompt text-xl">Experience</h2>
      <ul class="mt-4 grid gap-4">
        {site.experience.map((e) => (
          <li>
            <h3 class="font-semibold">
              {e.title}, {e.place} <span class="font-normal text-muted">({e.period})</span>
            </h3>
            <ul class="mt-1 list-disc pl-5 text-sm">
              {e.points.map((pt) => <li>{pt}</li>)}
            </ul>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="shipped-heading" class="mt-8">
      <h2 id="shipped-heading" class="prompt text-xl">Shipped work</h2>
      <ul class="mt-4 grid gap-4">
        {site.shippedWork.map((w) => (
          <li>
            <h3 class="font-semibold">
              {w.name} <span class="font-normal text-muted">({w.kind})</span>
            </h3>
            <p class="mt-1 text-sm">{w.text}</p>
            {w.url && (
              <p class="mt-1 text-xs"><a class="link" href={w.url} rel="noopener" target="_blank">{w.url}</a></p>
            )}
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="education-heading" class="mt-8">
      <h2 id="education-heading" class="prompt text-xl">Education</h2>
      <ul class="mt-4 text-sm">
        {site.education.map((e) => <li>{e.title}, {e.place} ({e.period})</li>)}
      </ul>
    </section>

    <section aria-labelledby="award-heading" class="mt-8">
      <h2 id="award-heading" class="prompt text-xl">Award</h2>
      <p class="mt-4 text-sm">
        {site.award.title}.{' '}
        <a class="link text-xs" href={site.award.url} rel="noopener" target="_blank">{site.award.url}</a>
      </p>
    </section>

    <section aria-labelledby="skills-heading" class="mt-8">
      <h2 id="skills-heading" class="prompt text-xl">Skills</h2>
      <dl class="mt-4 grid gap-3 text-sm">
        {site.skills.map((g) => (
          <div class="grid gap-1 sm:grid-cols-[8rem_1fr]">
            <dt class="font-semibold">{g.label}</dt>
            <dd>{g.items.join(', ')}</dd>
          </div>
        ))}
        {categories.map((c) => {
          const tech = techForCategory(c.key);
          return tech.length > 0 && (
            <div class="grid gap-1 sm:grid-cols-[8rem_1fr]">
              <dt class="font-semibold">{c.label} (portfolio repos)</dt>
              <dd>{tech.join(', ')}</dd>
            </div>
          );
        })}
      </dl>
    </section>

    <section aria-labelledby="projects-heading" class="mt-8">
      <h2 id="projects-heading" class="prompt text-xl">Portfolio and open-source projects</h2>
      <p class="mt-2 text-sm text-muted">
        {projects.length} projects on GitHub. These are portfolio work, not production deployments, and no user numbers are claimed.
      </p>
      <ul class="mt-4 grid gap-5 print-cols">
        {projects.map((p) => (
          <li>
            <h3 class="font-semibold">
              {p.name} <span class="font-normal text-muted">({p.category})</span>
            </h3>
            <p class="mt-1 text-sm">{p.tagline}</p>
            <p class="mt-1 text-xs text-muted">{p.stack.join(', ')}</p>
            <p class="mt-1 text-xs print-hide">
              <a class="link" href={p.repoUrl} rel="noopener noreferrer" target="_blank">{p.repoUrl}</a>
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="templates-heading" class="mt-8">
      <h2 id="templates-heading" class="prompt text-xl">Starter templates</h2>
      <ul class="mt-4 grid gap-4 print-cols">
        {templates.map((t) => (
          <li>
            <h3 class="font-semibold">
              {t.name} <span class="font-normal text-muted">({t.platform})</span>
            </h3>
            <p class="mt-1 text-sm print-hide">{t.description}</p>
            <p class="mt-1 text-xs text-muted">{t.stack.join(', ')}</p>
          </li>
        ))}
      </ul>
    </section>

  </article>
</Base>
