---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../data/site';
import { techForCategory } from '../lib/content';

// Services are described by the categories of work in the project data, so the
// stack lists below stay in step with what is actually in the repository.
const services = [
  { title: 'Web applications', category: 'web' as const, text: 'Full-stack web apps with server-rendered or single-page frontends and their APIs.' },
  { title: 'Mobile apps', category: 'mobile' as const, text: 'Native and cross-platform clients for iOS, Android and Flutter, with push and local notifications where needed.' },
  { title: 'Backend services', category: 'backend' as const, text: 'APIs, background jobs and data stores, with authentication, tenancy and CI set up from the start.' },
];
const mailto = `mailto:${site.email}`;
---

<Base title="Contact" description="Contact Ahmed Rajab by email or phone, and what work is on offer.">
  <Section id="contact" as="h1" path="~/contact" command="mail">
    <div class="grid gap-10 md:grid-cols-[3fr_2fr]">
      <div class="space-y-10">
        <section aria-labelledby="email-heading">
          <h2 id="email-heading" class="prompt text-lg"><span class="prompt-path">~/email</span></h2>
          <p class="mt-3">
            Write to <a class="link font-mono" href={mailto}>{site.email}</a>. This page sends no data anywhere:
            the link opens your own mail app.
          </p>
          <ul class="mt-3 grid gap-1 font-mono text-sm">
            <li>Phone / WhatsApp: <a class="link" href={site.phoneHref}>{site.phone}</a></li>
            <li>Alternative email: <a class="link" href={`mailto:${site.emailSecondary}`}>{site.emailSecondary}</a></li>
          </ul>

          <!-- Enhancement: shown only when JavaScript runs. Without it the plain link above is the whole feature. -->
          <div class="mt-6 rounded-lg border border-line bg-surface p-5" data-mailto-builder hidden>
            <h3 class="font-mono text-base font-semibold">Build a draft</h3>
            <p class="mt-1 text-sm text-muted">Optional. Fill in what you like; the link below opens a pre-filled email.</p>
            <div class="mt-4 grid gap-4">
              <label class="grid gap-1 text-sm">
                <span>Your name</span>
                <input
                  id="mailto-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  maxlength="100"
                  class="min-h-11 rounded border border-control bg-bg px-3 text-text focus:border-accent" />
              </label>
              <label class="grid gap-1 text-sm">
                <span>Message</span>
                <textarea
                  id="mailto-message"
                  name="message"
                  rows="5"
                  maxlength="4000"
                  class="rounded border border-control bg-bg px-3 py-2 text-text focus:border-accent"></textarea>
              </label>
            </div>
            <p class="mt-4">
              <a class="btn btn-primary" data-mailto-link href={mailto}>Open draft in your mail app</a>
            </p>
          </div>
        </section>

        <section aria-labelledby="work-heading">
          <h2 id="work-heading" class="prompt text-lg"><span class="prompt-path">~/work-with-me</span></h2>
          <ul class="mt-4 grid gap-4">
            {services.map((s) => (
              <li class="rounded-lg border border-line bg-surface p-5">
                <h3 class="font-mono font-semibold">{s.title}</h3>
                <p class="mt-1 text-sm text-muted">{s.text}</p>
                <p class="mt-3 font-mono text-xs text-muted">
                  <span class="sr-only">Stack seen in this portfolio: </span>{techForCategory(s.category).slice(0, 6).join(' · ')}
                </p>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <section aria-labelledby="social-heading">
        <h2 id="social-heading" class="prompt text-lg"><span class="prompt-path">~/profiles</span></h2>
        <SocialLinks class="mt-4" label="Profiles" />
      </section>
    </div>
  </Section>
</Base>

<script>
  // Progressive enhancement: build a mailto: link from the name and message fields.
  // Failure here only leaves the static mailto link in place.
  const builder = document.querySelector<HTMLElement>('[data-mailto-builder]');
  const link = document.querySelector<HTMLAnchorElement>('[data-mailto-link]');
  const nameInput = document.getElementById('mailto-name') as HTMLInputElement | null;
  const messageInput = document.getElementById('mailto-message') as HTMLTextAreaElement | null;

  if (builder && link && nameInput && messageInput) {
    const base = link.getAttribute('href') ?? '';
    const update = () => {
      const name = nameInput.value.trim();
      const message = messageInput.value.trim();
      const subject = name ? `Enquiry from ${name}` : 'Enquiry from the portfolio';
      const bodyParts = [message, name ? `\n\n-- ${name}` : ''];
      const query = `subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyParts.join(''))}`;
      link.href = `${base}?${query}`;
    };
    nameInput.addEventListener('input', update);
    messageInput.addEventListener('input', update);
    update();
    builder.hidden = false;
  }
</script>
