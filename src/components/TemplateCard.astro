---
import type { Template } from '../lib/content';
import TagChip from './TagChip.astro';

interface Props {
  template: Template;
  /** Where the card links to. Defaults to the repository. */
  href?: string;
  maxTags?: number;
}
const { template, href = template.repoUrl, maxTags = 4 } = Astro.props;
const external = /^https?:\/\//.test(href);
const shown = template.stack.slice(0, maxTags);
const hidden = template.stack.length - shown.length;
---

<article
  class="group relative flex h-full flex-col gap-3 rounded-lg border border-line bg-surface p-5 transition-colors hover:border-accent focus-within:border-accent">
  <div class="flex items-center justify-between gap-3">
    <TagChip label={template.platform} tone="accent" />
    {external && <span class="font-mono text-xs text-muted" aria-hidden="true">template ↗</span>}
  </div>
  <h3 class="font-mono text-lg font-semibold">
    <a
      href={href}
      class="text-text no-underline after:absolute after:inset-0 after:content-[''] hover:text-accent focus-visible:outline-offset-4"
      {...external ? { rel: 'noopener noreferrer', target: '_blank' } : {}}>
      {template.name}
      {external && <span class="sr-only"> (opens GitHub in a new tab)</span>}
    </a>
  </h3>
  <p class="text-sm text-muted">{template.description}</p>
  <ul class="mt-auto flex flex-wrap gap-1.5 pt-2" aria-label="Main technologies">
    {shown.map((tech) => <li><TagChip label={tech} /></li>)}
    {hidden > 0 && <li><TagChip label={`+${hidden}`} /></li>}
  </ul>
</article>
